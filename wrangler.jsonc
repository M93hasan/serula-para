{
  // PARA Trading preview: Cloudflare Workers + Vite static assets.
  // Production is fail-closed until Google OAuth secrets are configured in Cloudflare.
  "name": "serula-para",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "cloudflare/worker.js",
  "vars": {
    "GOOGLE_OAUTH_CLIENT_ID": "200434213389-cbkplrr8tj6lumaorj2jqbc78t9eaap1.apps.googleusercontent.com",
    "GOOGLE_ALLOWED_EMAIL": "m93hasan@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://para.serula.site/auth/google/callback"
  },
  "ratelimits": [{ "name": "ANALYSIS_LIMIT", "namespace_id": "1638020472", "simple": { "limit": 3, "period": 60 } }],
  "previews": {
    "vars": {
      "GOOGLE_OAUTH_CLIENT_ID": "200434213389-cbkplrr8tj6lumaorj2jqbc78t9eaap1.apps.googleusercontent.com",
      "GOOGLE_ALLOWED_EMAIL": "m93hasan@gmail.com",
      "GOOGLE_REDIRECT_URI": "https://feat-para-integration-20261106-local-serula-para.m93hasan.workers.dev/auth/google/callback"
    },
    "ratelimits": [{ "name": "ANALYSIS_LIMIT", "namespace_id": "1638020471", "simple": { "limit": 3, "period": 60 } }]
  },
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
